# ---- Wix Headless CMS ----
# Leave these empty to use the local seed content in src/content/seed.js.

# Option A (simplest): Headless OAuth app client ID.
# Wix dashboard → Settings → Headless Settings → OAuth apps → create → copy Client ID.
# Collections must allow "Anyone" to read.
WIX_CLIENT_ID=

# Option B (server-only, can read private collections): API key + site ID.
# WIX_API_KEY=
# WIX_SITE_ID=

# Optional: override collection IDs if you named them differently in Wix.
# WIX_COLLECTION_PROFILE=Profile
# WIX_COLLECTION_PROJECTS=Projects
# WIX_COLLECTION_CATEGORIES=Categories
# WIX_COLLECTION_SERVICES=Services
# WIX_COLLECTION_EXPERIENCE=Experience

# Shared secret for POST /api/revalidate (called by a Wix Automation when content changes).
REVALIDATE_SECRET=

# Public URL of the deployed site (used for social share images).
NEXT_PUBLIC_SITE_URL=https://nehaondhia.com
